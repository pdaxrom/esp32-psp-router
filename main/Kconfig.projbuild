menu "PSP USB router"
    choice PSP_NETWORK_MODE
        prompt "Network architecture"
        default PSP_MODE_ROUTER
        config PSP_MODE_ROUTER
            bool "USB WAN + Wi-Fi LAN, IPv4 NAPT and browser gateway"
        config PSP_MODE_BRIDGE
            bool "USB/Wi-Fi bridge (optional browser gateway)"
    endchoice

    config PSP_HTTP_PROXY
        bool "PSP HTTP to HTTPS browser gateway"
        default y if PSP_MODE_ROUTER
        default n
        help
            In bridge mode, also answers the exact DNS name psp-proxy for Wi-Fi
            clients using the current bridge DHCP address. Other DNS and DHCP
            traffic stays on the computer's network. No NAT or local DHCP server.

    config PSP_BRIDGE_PROXY
        bool
        default y if PSP_MODE_BRIDGE && PSP_HTTP_PROXY

    config PSP_PROXY_PORT
        int "Browser proxy TCP port"
        depends on PSP_HTTP_PROXY
        range 1024 65535
        default 8080

    choice PSP_USB_PROFILE
        prompt "USB host operating system"
        default PSP_USB_RNDIS
        config PSP_USB_RNDIS
            bool "Windows 10/11: RNDIS"
        config PSP_USB_ECM
            bool "macOS / Linux: CDC-ECM"
    endchoice

    choice PSP_AP_SECURITY
        prompt "Wi-Fi security (never changes automatically)"
        default PSP_AP_WPA2
        config PSP_AP_WPA2
            bool "WPA2-PSK / AES-CCMP (ARK-5 WPA2 Support enabled)"
        config PSP_AP_WPA1
            bool "WPA-PSK / TKIP (PSP compatible)"
        config PSP_AP_OPEN
            bool "OPEN diagnostic network (explicit opt-in)"
    endchoice

    config PSP_AP_PASSWORD
        string "Wi-Fi passphrase (8..63 printable ASCII characters)"
        default "psp3000wifi"
        depends on PSP_AP_WPA1 || PSP_AP_WPA2
        help
            Invalid passwords stop startup; they never select an open AP.

endmenu
